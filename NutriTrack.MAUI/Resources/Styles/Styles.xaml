                            <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Tarjeta blanca del panel (animales y módulos) -->
    <Style TargetType="Border" x:Key="TarjetaPanel">
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="Stroke" Value="{StaticResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <!-- Fila clickeable de una tarjeta de módulo -->
    <Style TargetType="Border" x:Key="FilaMenu">
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="Stroke" Value="{StaticResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Título chico en mayúsculas con letras separadas ("ANIMALES", "MÓDULOS") -->
    <Style TargetType="Label" x:Key="TituloSeccion">
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <!-- Alertas: color según la categoría (CategoriaAlerta). Se usan en la lista y en el pantallazo del panel.
         Sin trigger que coincida (categoría desconocida) queda el color neutro -->
    <Style TargetType="BoxView" x:Key="IndicadorAlerta">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Color" Value="{StaticResource TextoSecundario}" />
        <Style.Triggers>
            <DataTrigger x:DataType="models:Alerta" TargetType="BoxView" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.ProximaAplicacion}">
                <Setter Property="Color" Value="{StaticResource AlertaProximaAplicacion}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:Alerta" TargetType="BoxView" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.VencimientoSanitario}">
                <Setter Property="Color" Value="{StaticResource AlertaVencimiento}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:Alerta" TargetType="BoxView" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.VencimientoPlan}">
                <Setter Property="Color" Value="{StaticResource AlertaPlan}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:Alerta" TargetType="BoxView" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.DesvioPeso}">
                <Setter Property="Color" Value="{StaticResource AlertaDesvioPeso}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Label" x:Key="TipoAlerta">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
        <Style.Triggers>
            <DataTrigger x:DataType="models:Alerta" TargetType="Label" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.ProximaAplicacion}">
                <Setter Property="TextColor" Value="{StaticResource AlertaProximaAplicacion}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:Alerta" TargetType="Label" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.VencimientoSanitario}">
                <Setter Property="TextColor" Value="{StaticResource AlertaVencimiento}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:Alerta" TargetType="Label" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.VencimientoPlan}">
                <Setter Property="TextColor" Value="{StaticResource AlertaPlan}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:Alerta" TargetType="Label" Binding="{Binding Categoria}" Value="{x:Static models:CategoriaAlerta.DesvioPeso}">
                <Setter Property="TextColor" Value="{StaticResource AlertaDesvioPeso}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

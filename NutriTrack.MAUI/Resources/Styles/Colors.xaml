<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->
    <!-- este es de como se ve en windows -->
    <!-- Paleta NutriTrack (tomada del prototipo de Figma) -->
    <Color x:Key="Primary">#00873A</Color>
    <Color x:Key="PrimaryDark">#006B2E</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#E9F7EE</Color>
    <Color x:Key="SecondaryDarkText">#008236</Color>
    <Color x:Key="Tertiary">#016630</Color>

    <!-- Colores propios de NutriTrack -->
    <Color x:Key="Fondo">#F9FAFB</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="Borde">#E5E7EB</Color>
    <Color x:Key="TextoPrincipal">#101828</Color>
    <Color x:Key="TextoSecundario">#6A7282</Color>
    <Color x:Key="Peligro">#E7000B</Color>
    <Color x:Key="PeligroSuave">#FEF2F2</Color>

    <!-- Verde oscuro de la barra del Shell y del encabezado del panel -->
    <Color x:Key="VerdeOscuro">#0F3B24</Color>
    <!-- Textos y fondos sobre el verde oscuro -->
    <Color x:Key="TextoSobreVerde">#C6E9D3</Color>
    <Color x:Key="BlancoTranslucido">#26FFFFFF</Color>
    <Color x:Key="BordeTranslucido">#66FFFFFF</Color>

    <!-- Acentos de cada módulo del panel (color / suave) -->
    <Color x:Key="AcentoAnimal">#00873A</Color>
    <Color x:Key="AcentoAnimalSuave">#E9F7EE</Color>
    <Color x:Key="AcentoSanitario">#1F6FB2</Color>
    <Color x:Key="AcentoSanitarioSuave">#EAF2FA</Color>
    <Color x:Key="AcentoAlimenticio">#B26B00</Color>
    <Color x:Key="AcentoAlimenticioSuave">#FBF2E3</Color>
    <Color x:Key="AcentoAdministracion">#4B5A66</Color>
    <Color x:Key="AcentoAdministracionSuave">#EEF1F3</Color>

    <!-- Degradado horizontal del encabezado del panel -->
    <LinearGradientBrush x:Key="DegradadoEncabezado" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource VerdeOscuro}" Offset="0" />
        <GradientStop Color="{StaticResource Primary}" Offset="1" />
    </LinearGradientBrush>

    <!-- Colores base que usa Styles.xaml (NO BORRAR) -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
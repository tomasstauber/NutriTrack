<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NutriTrack.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NutriTrack.MAUI.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource VerdeOscuro}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Title="NutriTrack">

    <!-- Pantallas principales: se navega a ellas con "//ruta" (borra el historial) -->
    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent Route="panel"
                  Title="Panel Principal"
                  ContentTemplate="{DataTemplate views:PanelPrincipalPage}" />
</Shell>
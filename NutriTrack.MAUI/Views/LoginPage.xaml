<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriTrack.MAUI.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Fondo}">

    <!-- Esto es tipo provisorio para probar el diseño real se hace en la Fase 1 -->
    <VerticalStackLayout Spacing="16" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="NutriTrack"
               FontSize="32"
               FontAttributes="Bold"
               TextColor="{StaticResource TextoPrincipal}"
               HorizontalOptions="Center" />
        <Label Text="Pantalla de login (en construcción)"
               TextColor="{StaticResource TextoSecundario}"
               HorizontalOptions="Center" />
        <Button Text="Entrar (prueba de navegación)"
                Clicked="OnEntrarClicked" />
    </VerticalStackLayout>
</ContentPage>
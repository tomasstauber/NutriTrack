<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NutriTrack.MAUI.ViewModels"
             xmlns:models="clr-namespace:NutriTrack.MAUI.Models"
             xmlns:helpers="clr-namespace:NutriTrack.MAUI.Helpers"
             x:Class="NutriTrack.MAUI.Views.RodeoAsignadoPage"
             x:DataType="vm:RodeoAsignadoViewModel"
             Title="Rodeo asignado"
             BackgroundColor="{StaticResource Fondo}">

    <ContentPage.Resources>
        <helpers:NuloAGuionConverter x:Key="NuloAGuion" />

        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="Dato" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="Encabezado" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="Celda" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Padding="16">

        <!-- Encabezado: datos del rodeo y vigencia de la asignación -->
        <Border Grid.Row="0"
                Padding="12"
                Stroke="{StaticResource Borde}"
                BackgroundColor="{StaticResource Superficie}">
            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="6">
                <Label Grid.Row="0" Grid.Column="0" Text="Rodeo" Style="{StaticResource Etiqueta}" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Asignacion.NombreRodeo}" Style="{StaticResource Dato}" />

                <Label Grid.Row="1" Grid.Column="0" Text="Descripción" Style="{StaticResource Etiqueta}" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Asignacion.DescripcionRodeo, Converter={StaticResource NuloAGuion}}" Style="{StaticResource Dato}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Animales activos" Style="{StaticResource Etiqueta}" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Asignacion.CantidadAnimales}" Style="{StaticResource Dato}" />

                <Label Grid.Row="3" Grid.Column="0" Text="Vigencia desde" Style="{StaticResource Etiqueta}" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Asignacion.TextoVigenciaDesde}" Style="{StaticResource Dato}" />

                <Label Grid.Row="4" Grid.Column="0" Text="Vigencia hasta" Style="{StaticResource Etiqueta}" />
                <Label Grid.Row="4" Grid.Column="1" Text="{Binding Asignacion.TextoVigenciaHasta}" Style="{StaticResource Dato}" />
            </Grid>
        </Border>

        <!-- Errores de la API -->
        <Label Grid.Row="1"
               Text="{Binding MensajeError}"
               IsVisible="{Binding HayError}"
               TextColor="{StaticResource Peligro}" />

        <!-- Animales activos del rodeo -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Animales}"
                        EmptyView="{Binding MensajeVacio}">

            <CollectionView.Header>
                <Grid ColumnDefinitions="2*,2*,*,*"
                      ColumnSpacing="8"
                      Padding="8"
                      BackgroundColor="{StaticResource Superficie}">
                    <Label Grid.Column="0" Text="Caravana" Style="{StaticResource Encabezado}" />
                    <Label Grid.Column="1" Text="Raza" Style="{StaticResource Encabezado}" />
                    <Label Grid.Column="2" Text="Sexo" Style="{StaticResource Encabezado}" />
                    <Label Grid.Column="3" Text="Nacimiento" Style="{StaticResource Encabezado}" />
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AnimalListado">
                    <Grid RowDefinitions="*,Auto">
                        <!-- Tocar un animal abre su perfil -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RodeoAsignadoViewModel}}, Path=SeleccionarCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Grid ColumnDefinitions="2*,2*,*,*"
                              ColumnSpacing="8"
                              Padding="8">
                            <Label Grid.Column="0" Text="{Binding Caravana}" Style="{StaticResource Celda}" />
                            <Label Grid.Column="1" Text="{Binding Raza, Converter={StaticResource NuloAGuion}}" Style="{StaticResource Celda}" />
                            <Label Grid.Column="2" Text="{Binding Sexo}" Style="{StaticResource Celda}" />
                            <Label Grid.Column="3" Text="{Binding FechaNacimiento, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Celda}" />
                        </Grid>
                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Borde}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Contador y paginado -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Grid.Column="0"
                   Text="{Binding Contador}"
                   TextColor="{StaticResource TextoSecundario}"
                   VerticalOptions="Center" />
            <ActivityIndicator Grid.Column="0"
                               IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               HorizontalOptions="End" />
            <Button Grid.Column="1"
                    Text="Cargar más"
                    IsVisible="{Binding HayMas}"
                    IsEnabled="{Binding NoEstaOcupado}"
                    Command="{Binding CargarMasCommand}" />
        </Grid>
    </Grid>
</ContentPage>

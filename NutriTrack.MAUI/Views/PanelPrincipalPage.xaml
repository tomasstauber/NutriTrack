<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NutriTrack.MAUI.ViewModels"
             xmlns:models="clr-namespace:NutriTrack.MAUI.Models"
             xmlns:helpers="clr-namespace:NutriTrack.MAUI.Helpers"
             x:Class="NutriTrack.MAUI.Views.PanelPrincipalPage"
             x:DataType="vm:PanelPrincipalViewModel"
             Title="Panel Principal"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Fondo}">

    <ContentPage.Resources>
        <!-- Tarjeta de un módulo: la usan la grilla de dos columnas y la de una -->
        <DataTemplate x:Key="PlantillaModulo" x:DataType="models:GrupoMenu">
            <Border Style="{StaticResource TarjetaPanel}"
                    helpers:Animaciones.Aparicion="True"
                    helpers:Animaciones.ElevarAlPasar="True">
                <VerticalStackLayout>
                    <!-- Franja superior con el color del módulo -->
                    <BoxView HeightRequest="4">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding Clave}" Value="Animal">
                                <Setter Property="Color" Value="{StaticResource AcentoAnimal}" />
                            </DataTrigger>
                            <DataTrigger TargetType="BoxView" Binding="{Binding Clave}" Value="Sanitario">
                                <Setter Property="Color" Value="{StaticResource AcentoSanitario}" />
                            </DataTrigger>
                            <DataTrigger TargetType="BoxView" Binding="{Binding Clave}" Value="Alimenticio">
                                <Setter Property="Color" Value="{StaticResource AcentoAlimenticio}" />
                            </DataTrigger>
                            <DataTrigger TargetType="BoxView" Binding="{Binding Clave}" Value="Administracion">
                                <Setter Property="Color" Value="{StaticResource AcentoAdministracion}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>

                    <VerticalStackLayout Padding="16" Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <!-- Recuadro con la sigla del módulo -->
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Clave}" Value="Animal">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AcentoAnimalSuave}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Clave}" Value="Sanitario">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AcentoSanitarioSuave}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Clave}" Value="Alimenticio">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AcentoAlimenticioSuave}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Clave}" Value="Administracion">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AcentoAdministracionSuave}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label Text="{Binding Sigla}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Clave}" Value="Animal">
                                            <Setter Property="TextColor" Value="{StaticResource AcentoAnimal}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Clave}" Value="Sanitario">
                                            <Setter Property="TextColor" Value="{StaticResource AcentoSanitario}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Clave}" Value="Alimenticio">
                                            <Setter Property="TextColor" Value="{StaticResource AcentoAlimenticio}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Clave}" Value="Administracion">
                                            <Setter Property="TextColor" Value="{StaticResource AcentoAdministracion}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Titulo}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="17"
                                       TextColor="{StaticResource TextoPrincipal}" />
                                <Label Text="{Binding Descripcion}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Una fila por opción del módulo -->
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding Entradas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:EntradaMenu">
                                    <Border Style="{StaticResource FilaMenu}"
                                            helpers:Animaciones.Interactivo="True">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanelPrincipalViewModel}}, Path=NavegarCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Titulo}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextoPrincipal}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="›"
                                                   FontSize="20"
                                                   TextColor="{StaticResource TextoSecundario}"
                                                   VerticalOptions="Center"
                                                   helpers:Animaciones.Desplazable="True" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="16,20"
                             MaximumWidthRequest="960">

            <!-- Encabezado: saludo, rol y cerrar sesión -->
            <Border Background="{StaticResource DegradadoEncabezado}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="24"
                    helpers:Animaciones.Aparicion="True">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="NUTRITRACK · PANEL PRINCIPAL"
                               FontFamily="OpenSansSemibold"
                               FontSize="11"
                               CharacterSpacing="2"
                               TextColor="{StaticResource TextoSobreVerde}" />

                        <Label FontFamily="OpenSansSemibold"
                               FontSize="26"
                               TextColor="{StaticResource White}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Hola, " />
                                    <Span Text="{Binding Nombre}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Pastilla con el rol -->
                        <Border BackgroundColor="{StaticResource BlancoTranslucido}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="12,4"
                                HorizontalOptions="Start">
                            <Label Text="{Binding Rol}"
                                   FontSize="12"
                                   TextColor="{StaticResource White}" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Style="{StaticResource BotonFantasma}"
                            Text="Cerrar sesión"
                            Command="{Binding CerrarSesionCommand}"
                            VerticalOptions="Center"
                            helpers:Animaciones.Interactivo="True" />
                </Grid>
            </Border>

            <!-- Tarjeta de animales -->
            <Border Style="{StaticResource TarjetaPanel}"
                    Padding="20"
                    helpers:Animaciones.Aparicion="True">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="ANIMALES"
                               Style="{StaticResource TituloSeccion}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BotonLink}"
                                Text="Ver listado ›"
                                Command="{Binding IrAAnimalesCommand}"
                                IsVisible="{Binding PuedeVerAnimales}"
                                helpers:Animaciones.Interactivo="True" />
                    </Grid>

                    <!-- Activos | Registrados (la línea solo si se muestran los registrados) -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="24">
                        <VerticalStackLayout>
                            <Label Text="{Binding AnimalesActivos, TargetNullValue='—'}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="30"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Activos"
                                   TextColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="1"
                                 WidthRequest="1"
                                 Color="{StaticResource Borde}"
                                 BackgroundColor="{StaticResource Borde}"
                                 IsVisible="{Binding MostrarRegistrados}" />

                        <VerticalStackLayout Grid.Column="2"
                                             IsVisible="{Binding MostrarRegistrados}">
                            <Label Text="{Binding AnimalesRegistrados}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="30"
                                   TextColor="{StaticResource TextoPrincipal}" />
                            <Label Text="Registrados"
                                   TextColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                       IsVisible="{Binding EstaOcupado}"
                                       Color="{StaticResource Primary}" />

                    <Border BackgroundColor="{StaticResource PeligroSuave}"
                            Stroke="{StaticResource Peligro}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10"
                            IsVisible="{Binding HayError}">
                        <Label Text="{Binding MensajeError}"
                               TextColor="{StaticResource Peligro}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Módulos agrupados según el rol de la sesión -->
            <VerticalStackLayout Spacing="12">
                <Label Text="MÓDULOS"
                       Style="{StaticResource TituloSeccion}" />

                <!-- Ventana ancha: dos columnas (Grid y no FlexLayout: dentro del
                     ScrollView el FlexLayout mide mal el alto y deja filas sin clic) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="AnchoVentana">
                                <VisualState x:Name="Angosta">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Property="IsVisible" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Ancha">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="720" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Property="IsVisible" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>

                    <VerticalStackLayout Spacing="16"
                                         BindableLayout.ItemsSource="{Binding GruposIzquierda}"
                                         BindableLayout.ItemTemplate="{StaticResource PlantillaModulo}" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="16"
                                         BindableLayout.ItemsSource="{Binding GruposDerecha}"
                                         BindableLayout.ItemTemplate="{StaticResource PlantillaModulo}" />
                </Grid>

                <!-- Ventana angosta: una sola columna con todos los grupos -->
                <VerticalStackLayout Spacing="16"
                                     BindableLayout.ItemsSource="{Binding GruposMenu}"
                                     BindableLayout.ItemTemplate="{StaticResource PlantillaModulo}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="AnchoVentana">
                                <VisualState x:Name="Angosta">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Property="IsVisible" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Ancha">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="720" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Property="IsVisible" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </VerticalStackLayout>

                <Label Text="Todavía no hay módulos disponibles para tu rol."
                       TextColor="{StaticResource TextoSecundario}"
                       IsVisible="{Binding SinModulos}" />
            <!-- Tarjeta de alertas: solo Administrador. Estado propio, separado de la tarjeta de animales -->
            <Border BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    IsVisible="{Binding PuedeVerAlertas}">
                <Border.Triggers>
                    <!-- Resaltada si hay al menos una alerta; con 0 se ve normal -->
                    <DataTrigger TargetType="Border" Binding="{Binding HayAlertas}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource AvisoSuave}" />
                        <Setter Property="Stroke" Value="{StaticResource Aviso}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrAAlertasCommand}" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="8">
                    <!-- Título y campana. La campana es un Path (vector): se ve igual en Windows y Android
                         y se le puede cambiar el color; un emoji no toma TextColor -->
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Alertas"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Grid WidthRequest="30" HeightRequest="26" VerticalOptions="Center">
                            <!-- Ícono "notifications" de Material Icons (Apache 2.0), en una grilla de 24x24 -->
                            <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                  Fill="{StaticResource TextoSecundario}"
                                  Aspect="Uniform"
                                  WidthRequest="22"
                                  HeightRequest="22"
                                  HorizontalOptions="Start"
                                  VerticalOptions="End">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding HayAlertas}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Aviso}" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>

                            <!-- Globito con la cantidad, encima de la esquina de la campana -->
                            <Border BackgroundColor="{StaticResource Aviso}"
                                    Stroke="{StaticResource Superficie}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="4,0"
                                    MinimumWidthRequest="16"
                                    HeightRequest="16"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    IsVisible="{Binding HayAlertas}">
                                <Label Text="{Binding TotalAlertas}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </HorizontalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="{Binding TotalAlertas, TargetNullValue='—'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoPrincipal}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HayAlertas}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Aviso}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Sin leer"
                               TextColor="{StaticResource TextoSecundario}" />
                    </VerticalStackLayout>

                    <!-- Pantallazo: las primeras alertas NO leídas de la misma respuesta, en el orden del back.
                         BindableLayout y no CollectionView porque está dentro del ScrollView del panel.
                         InputTransparent: tocar una alerta llega al toque de la tarjeta y abre la lista -->
                    <VerticalStackLayout Spacing="6"
                                         InputTransparent="True"
                                         IsVisible="{Binding HayAlertas}">
                        <VerticalStackLayout Spacing="6"
                                             BindableLayout.ItemsSource="{Binding PrimerasAlertas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Alerta">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <!-- Punto con el color de la categoría (mismo estilo que la franja de la lista) -->
                                        <BoxView Grid.Column="0"
                                                 Style="{StaticResource IndicadorAlerta}"
                                                 WidthRequest="10"
                                                 HeightRequest="10"
                                                 CornerRadius="5"
                                                 VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource TextoPrincipal}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Destino}" FontAttributes="Bold" />
                                                    <Span Text=" · " />
                                                    <!-- La descripción, salvo en el desvío de peso: ahí solo las ganancias -->
                                                    <Span Text="{Binding TextoResumen}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Column="2"
                                               Text="{Binding TextoDiasRestantes}"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource TextoSecundario}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Cargó bien y no hay ninguna sin leer: sin alertas en el back o todas leídas -->
                    <Label Text="{Binding MensajeSinAlertas}"
                           IsVisible="{Binding SinAlertas}"
                           TextColor="{StaticResource TextoSecundario}" />

                    <!-- La lista tiene más alertas que el pantallazo (también si están todas leídas).
                         N = total de la lista, leídas incluidas. Fuera del pantallazo para verse aunque no haya no leídas -->
                    <Label Text="{Binding TextoVerTodas}"
                           IsVisible="{Binding HayMasAlertas}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Aviso}" />

                    <ActivityIndicator IsRunning="{Binding CargandoAlertas}"
                                       IsVisible="{Binding CargandoAlertas}"
                                       Color="{StaticResource Primary}" />

                    <Label Text="{Binding ErrorAlertas}"
                           IsVisible="{Binding HayErrorAlertas}"
                           TextColor="{StaticResource Peligro}" />
                </VerticalStackLayout>
            </Border>

            <!-- Menú armado según el rol de la sesión -->
            <Label Text="Menú"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextoPrincipal}" />

            <VerticalStackLayout Spacing="8"
                                 BindableLayout.ItemsSource="{Binding EntradasMenu}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:EntradaMenu">
                        <Button Text="{Binding Titulo}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanelPrincipalViewModel}}, Path=NavegarCommand}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                <BindableLayout.EmptyView>
                    <Label Text="Todavía no hay módulos disponibles para tu rol."
                           TextColor="{StaticResource TextoSecundario}" />
                </BindableLayout.EmptyView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
